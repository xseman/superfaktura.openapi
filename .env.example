# SuperFaktura API credentials for scripts/signature.sh (and the generated client).
# Find them in the app: Nástroje -> API prístup (https://moja.superfaktura.sk/api_access).
# Copy this file to .env (gitignored) and fill in the values.

# Base URL: https://moja.superfaktura.sk (SK), https://moje.superfaktura.cz (CZ),
# https://meine.superfaktura.at (AT), https://sandbox.superfaktura.sk / .cz (sandbox)
SF_API_URL=https://sandbox.superfaktura.sk

# Login email of the (dedicated) API user
SF_EMAIL=
# API key (Nástroje -> API prístup)
SF_API_KEY=
# Name of your integration, e.g. "MyCustomModule 1.0"
SF_MODULE=superfaktura.openapi signature.sh
# Optional: company ID when the user has access to multiple companies
SF_COMPANY_ID=
